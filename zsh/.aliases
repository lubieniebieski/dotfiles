# ===== ALIASES =====
# Note: slimzsh provides basic git aliases (gs, gl, gp, gd, gco)
# Adding complementary aliases here

# ===== FILE OPERATIONS =====
# eza (better ls)
alias ls='eza --icons=auto'
alias ll='eza -lh --icons=auto --git'
alias la='eza -lah --icons=auto --git'
alias tree='eza --tree --icons=auto'
compdef eza=ls  # reuse ls completions for eza

# bat (better cat)
alias cat='bat'

# ripgrep (better grep)
alias grep='rg --color=auto'

# General utilities
alias p8="ping 8.8.8.8"  # Quick connectivity test
alias reload='source ~/.zshrc'
alias -- -='cd -'  # -- prevents - being parsed as a flag; cd - jumps to previous directory

# ===== DEVELOPMENT =====
# Editors
alias vi='nvim'
alias vim='nvim'
alias code='code .'

# ===== RUBY & RAILS =====
# Rails shortcuts
alias r="rails"
alias rs="rails s"
alias rc="rails c"

# Bundle commands
alias be="bundle exec"
alias bi="bundle install"
alias bu="bundle update"

# ===== GIT =====
alias gb='git branch'
alias gc='git commit'
alias gca='git commit -a'
alias gcam='git commit -a -m'
alias gcm='git commit -m'
alias gco='git checkout'
alias gd='git diff'
alias gl='git pull'
alias glog='git log --oneline --graph --decorate'
alias gp='git push'
alias gs='git status'
alias gwc='git log -p --abbrev-commit --pretty=medium --raw --no-merges'  # git whatchanged is deprecated; this replicates it via git log
